+
+// Tout ce qu'affiche la page d'une équipe (organisation) :
+//   - classement Elo, bilan, plus gros gain/perte, historique récent
+//   - roster actif (5 principaux + remplaçants) et anciens joueurs
+//   - pour chaque joueur, ses stats calculées UNIQUEMENT sur ses matchs avec cette équipe
+//   - palmarès, avec le roster qui a réellement gagné
+// Les stats par équipe utilisent tous les matchs enregistrés (appliqués au classement ou non),
+// comme les records et les MVP/MJ.
+export function buildTeamPage(key, tournaments, players, { organizations = [], playerElo = new Map(), config = ELO_CONFIG } = {}) {
+  const ranking = computeTeamElo(tournaments, config, organizations);
+  const rankIndex = ranking.findIndex((r) => r.key === key);
+  if (rankIndex === -1) return null;
+  const entry = ranking[rankIndex];
+  const playerById = new Map(players.map((p) => [p.id, p]));
+
+  const stints = new Map(); // playerId → { stats, mvp, mj, first, last, tournaments:Set, trophies:[] }
+  const stintOf = (id) => {
+    if (!stints.has(id)) stints.set(id, { stats: emptyStats(), mvp: 0, mj: 0, first: "", last: "", tournaments: new Set(), trophies: [] });
+    return stints.get(id);
+  };
+  const palmares = [];
+
+  chronologicalTournaments(tournaments).forEach((t) => {
+    const team = t.teams.find((x) => orgKeyOf(x) === key);
+    if (!team) return;
+
+    team.playerIds.forEach((id) => {
+      const s = stintOf(id);
+      s.tournaments.add(t.id);
+      if (t.date) {
+        if (!s.first || t.date < s.first) s.first = t.date;
+        if (!s.last || t.date > s.last) s.last = t.date;
+      }
+    });
+
+    (t.matches || []).forEach((m) => {
+      if (m.teamAId !== team.id && m.teamBId !== team.id) return;
+      const side = m.teamAId === team.id ? "A" : "B";
+      const teamA = t.teams.find((x) => x.id === m.teamAId);
+      const teamB = t.teams.find((x) => x.id === m.teamBId);
+      const participation = computeParticipation(m, teamA, teamB);
+      participation.forEach((p, id) => {
+        if (p.side !== side) return;
+        const row = m.stats?.[id];
+        if (!hasAnyValue(row)) return;
+        const s = stintOf(id);
+        s.stats = applyMatchToStats(s.stats, row);
+      });
+      const { mvpId, mjId } = computeMvpMj(m.stats, teamA);
+      if (mvpId && participation.get(mvpId)?.side === side) stintOf(mvpId).mvp += 1;
+      if (mjId && participation.get(mjId)?.side === side) stintOf(mjId).mj += 1;
+    });
+
+    if (t.finished && t.winnerTeamId === team.id) {
+      palmares.push({ tournamentId: t.id, tournamentName: t.name, type: t.type, date: t.date, playerIds: [...team.playerIds] });
+      team.playerIds.forEach((id) => stintOf(id).trophies.push({ tournamentName: t.name, type: t.type }));
+    }
+  });
+
+  const toRow = (id) => {
+    const s = stints.get(id) || stintOf(id);
+    return {
+      id,
+      player: playerById.get(id) || null,
+      elo: playerElo.get(id)?.elo ?? config.start,
+      stats: { ...s.stats, mvp: s.mvp, mj: s.mj },
+      since: s.first,
+      until: s.last,
+      tournaments: s.tournaments.size,
+      trophies: s.trophies,
+    };
+  };
+
+  const activeIds = [...entry.roster.map((r) => r.id), ...entry.substitutes];
+  const activeSet = new Set(activeIds);
+  const active = activeIds.map((id) => ({ ...toRow(id), substitute: !entry.roster.some((r) => r.id === id) }));
+  const former = [...stints.keys()]
+    .filter((id) => !activeSet.has(id))
+    .map(toRow)
+    .sort((a, b) => b.stats.match - a.stats.match || String(b.until).localeCompare(String(a.until)));
+
+  const matches = entry.history.filter((h) => h.type === "match");
+  return {
+    entry,
+    rank: rankIndex + 1,
+    wins: matches.filter((h) => h.result === "W").length,
+    losses: matches.filter((h) => h.result === "L").length,
+    bestGain: pickExtreme(matches.filter((h) => h.delta > 0), (a, b) => b.delta > a.delta),
+    worstLoss: pickExtreme(matches.filter((h) => h.delta < 0), (a, b) => b.delta < a.delta),
+    recent: [...entry.history].reverse().slice(0, 12),
+    active,
+    former,
+    palmares: palmares.reverse(),
+    // utilisé plus tard pour les Légendes du club
+    allMembers: [...stints.keys()].map(toRow),
+  };
+}
diff --git a/src/domain/teamPage.test.js b/src/domain/teamPage.test.js
new file mode 100644
index 0000000..994cbdc
--- /dev/null
+++ b/src/domain/teamPage.test.js
@@ -0,0 +1,74 @@
+import { describe, it, expect } from "vitest";
+import { buildTeamPage } from "./teamPage.js";
+import { computeTeamElo, orgKeyOf } from "./elo.js";
+
+const P = (id) => ({ id, name: id.toUpperCase() });
+const players = ["a", "b", "c", "d", "e", "f", "g", "x"].map(P);
+const opp = (id) => ({ id, name: "Opp", playerIds: ["x"] });
+const row = (rating, kill) => ({ rating, kill, death: 10, maps: 2, round: 40 });
+
+// "a" joue 2 tournois chez DRX puis part chez T1 ; il garde ses stats DRX séparées
+const s1 = {
+  id: "s1", name: "Split 1", type: "Split", date: "2025-01-01", finished: true, winnerTeamId: "drx1",
+  teams: [{ id: "drx1", name: "DRX", playerIds: ["a", "b", "c", "d", "e"] }, opp("o1")],
+  matches: [{ id: "m1", teamAId: "drx1", teamBId: "o1", mapScores: [{ a: 13, b: 5 }, { a: 13, b: 7 }],
+    stats: { a: row(1.2, 30), b: row(1.0, 20), x: row(0.8, 15) } }],
+};
+const s2 = {
+  id: "s2", name: "Masters", type: "Masters", date: "2025-06-01",
+  teams: [{ id: "drx2", name: "drx ", playerIds: ["a", "b", "c", "d", "f", "g"] }, opp("o2")],
+  matches: [{ id: "m2", teamAId: "drx2", teamBId: "o2", mapScores: [{ a: 13, b: 5 }, { a: 13, b: 7 }],
+    stats: { a: row(1.0, 20) } }],
+};
+const s3 = {
+  id: "s3", name: "Split 2", type: "Split", date: "2026-01-01",
+  teams: [{ id: "drx3", name: "DRX", playerIds: ["b", "c", "d", "f", "g"] }, { id: "t1", name: "T1", playerIds: ["a"] }],
+  matches: [{ id: "m3", teamAId: "drx3", teamBId: "t1", mapScores: [{ a: 13, b: 5 }], stats: { a: row(2.0, 40), b: row(1.0, 10) } }],
+};
+const tournaments = [s1, s2, s3];
+const key = orgKeyOf({ name: "DRX" });
+
+describe("page équipe", () => {
+  const page = buildTeamPage(key, tournaments, players);
+
+  it("les stats d'un ancien joueur ne comptent que ses matchs avec l'équipe", () => {
+    const a = page.former.find((r) => r.id === "a");
+    expect(a.stats.match).toBe(2);
+    expect(a.stats.kill).toBe(50);
+    expect(a.stats.rating).toBeCloseTo(1.1);
+    expect(a.since).toBe("2025-01-01");
+    expect(a.until).toBe("2025-06-01");
+  });
+
+  it("le roster actif vient du dernier tournoi, les autres sont anciens", () => {
+    expect(page.active.map((r) => r.id).sort()).toEqual(["b", "c", "d", "f", "g"]);
+    expect(page.former.map((r) => r.id).sort()).toEqual(["a", "e"]);
+  });
+
+  it("le palmarès garde le roster qui a gagné", () => {
+    expect(page.palmares).toHaveLength(1);
+    expect(page.palmares[0].playerIds).toContain("e");
+    expect(page.former.find((r) => r.id === "e").trophies).toHaveLength(1);
+  });
+
+  it("MVP compté seulement dans l'équipe où il a été obtenu", () => {
+    expect(page.former.find((r) => r.id === "a").stats.mvp).toBe(2);
+  });
+
+  it("une organisation rattachée garde son historique même renommée", () => {
+    const withOrg = tournaments.map((t) => ({
+      ...t, teams: t.teams.map((team) => (team.id.startsWith("drx") ? { ...team, organizationId: "org_drx", name: t.id === "s3" ? "DRX Academy" : team.name } : team)),
+    }));
+    const ranking = computeTeamElo(withOrg, undefined, [{ id: "org_drx", name: "DRX" }]);
+    const drx = ranking.find((r) => r.key === "org_drx");
+    expect(drx.name).toBe("DRX");
+    expect(drx.history.filter((h) => h.type === "match")).toHaveLength(3);
+  });
+
+  it("un roster corrigé à la main remplace celui du dernier tournoi", () => {
+    const ranking = computeTeamElo(tournaments, undefined, [{ id: key, name: "DRX", rosterOverride: ["b", "c", "d", "f", "e"] }]);
+    const drx = ranking.find((r) => r.key === key);
+    expect(drx.manualRoster).toBe(true);
+    expect(drx.roster.map((r) => r.id).sort()).toEqual(["b", "c", "d", "e", "f"]);
+  });
+});
